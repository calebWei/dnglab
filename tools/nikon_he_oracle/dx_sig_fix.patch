+static inline int ceil_div(int a, int b) { return (a + b - 1) / b; }
+
+// DX FIX: the per-LB significance substream size is NOT a global f20. Significance
+// is coded 1 bit per significance-group (Ss=8 coeff-groups), packed 8 bits/byte:
+//   sig_bytes[lb] = ceil( sum_over_subbands_in_lb( ceil(ng_sb / 8) ) / 8 )
+// Verified against Z50 II (DX) HE: sig = [12,12,11,12,11,11,11,11]; all 8 LB
+// mini-headers align. (The reference's sig=f20 only held for FX.)
+static void compute_lb_sig_bytes(int image_width, uint32_t sig_out[8]) {
+    const int half = image_width / 2;
+    const int ng_max = (half + 7) / 8;
+    const int ng_ll  = half / 4;
+    const int n4 = (ng_max + 1) / 2;
+    const int n5 = (n4 + 1) / 2;
+    const int n_h5 = n4 - n5;
+    const int ng5[6] = {
+        (n5 + 3) / 4, (n_h5 + 3) / 4, (ng_max + 7) / 8,
+        (ng_max + 3) / 4, (ng_max + 1) / 2, ng_max,
+    };
+    int groups_5level = 0;
+    for (int i = 0; i < 6; ++i) groups_5level += ceil_div(ng5[i], 8);
+    const int groups_ll = ceil_div(ng_ll, 8);
+    const int groups_1level = 2 * ceil_div(ng_max, 8);
+    const int groups_per_lb[8] = {
+        groups_5level, groups_5level, groups_ll, groups_5level,
+        groups_1level, groups_1level, groups_ll, groups_1level,
+    };
+    for (int lb = 0; lb < 8; ++lb) sig_out[lb] = (uint32_t)ceil_div(groups_per_lb[lb], 8);
+}
